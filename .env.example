# =============================================================================
# CSREP & FACEIT DEMO UPLOADER — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Скопируйте этот файл в '.env' и заполните ваши персональные параметры:
# cp .env.example .env
# ВНИМАНИЕ: Никогда не коммитьте боевой файл '.env' в Git-репозиторий!

# --- STEAM & FACEIT CREDENTIALS (CRITICAL) ---
# Ваш 17-значный Steam ID 64 (SteamID64)
STEAM_ID=

# FACEIT Data API Key (получить на https://developers.faceit.com/ -> Create App)
FACEIT_API_KEY=

# --- ПАРАМЕТРЫ ПРОИЗВОДИТЕЛЬНОСТИ И ЗАГРУЗКИ ---
# Количество страниц матчей csrep.gg для проверки по умолчанию (20 матчей на страницу, 3 = 60 матчей)
MAX_PAGES=3

# Количество параллельных потоков multipart-загрузки чанков в Cloudflare R2 (1-16)
CHUNK_CONCURRENCY=4

# Размер чанка загрузки в байтах (по умолчанию 10 MB = 10485760)
CHUNK_SIZE_BYTES=10485760

# --- WEB DASHBOARD & СЕТЕВАЯ БЕЗОПАСНОСТЬ ---
# Порт встроенного веб-сервера / Web Studio
WEB_PORT=3333

# Сетевой интерфейс (127.0.0.1 - строго локально и безопасно; 0.0.0.0 - доступ по LAN)
WEB_HOST=127.0.0.1

# Секретный токен для доступа к API веб-дашборда (защита от несанкционированного доступа / CSRF)
API_SECRET_TOKEN=

# --- ФОНОВЫЙ МОНИТОРИНГ (WATCH MODE) ---
# Интервал проверки новых матчей в минутах
WATCH_INTERVAL_MINUTES=10

# --- ПУТИ К ХРАНИЛИЩУ И СЕССИЯМ (Опционально) ---
TEMP_DOWNLOADS_DIR=./demos_temp
BROWSER_SESSION_DIR=./.browser_session
COOKIES_FILE=./cookies.json
HISTORY_FILE=./uploaded_history.json
